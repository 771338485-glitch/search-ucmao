# ============================================
# 小青搜剧 - 环境配置示例
# ============================================
# 将此文件复制为 .env 并填入实际配置
# cp .env.example .env

# ============================================
# 系统配置
# ============================================
# JWT签名密钥（请务必修改为随机字符串）
SECRET_KEY=your-secret-key-here-please-change-this
# API密钥（用于公共接口访问）
API_KEY=your-api-key-here
# 加密密钥（至少32字节，请务必修改）
ENCRYPTION_KEY=change-this-to-a-random-string-at-least-32-bytes-long

# ============================================
# 管理员账号配置
# ============================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============================================
# 应用端口
# ============================================
# PORT=5004

# ============================================
# 可选：网盘 Cookie 配置
# ============================================
# QUARK_PAN_COOKIE=your-quark-cookie-here
# BAIDU_PAN_COOKIE=your-baidu-cookie-here

# ============================================
# 可选：默认保存目录
# ============================================
# DEFAULT_SAVE_DIR=桃白白影视
